<?xml version="1.0" encoding="utf-8"?>
<mdscript name="HcpBench" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <cue name="BenchStart" checkinterval="5s">
      <conditions>
        <check_value value="global.$X4ShipTestActive? and player.sector and (player.occupiedship or player.entity)"/>
      </conditions>
      <delay exact="5s"/>
      <actions>
        <cancel_cue cue="BenchGiveUp"/>
        <signal_cue cue="BenchSpawn"/>
      </actions>
      <cues>
        <cue name="BenchReload" instantiate="true">
          <conditions>
            <event_game_loaded/>
          </conditions>
          <delay exact="8s"/>
          <actions>
            <signal_cue cue="BenchSpawn"/>
          </actions>
        </cue>
      </cues>
    </cue>

    <cue name="BenchGiveUp" checkinterval="30s">
      <conditions>
        <check_value value="player.age gt 300s and not global.$X4ShipTestActive?"/>
      </conditions>
      <actions>
        <cancel_cue cue="BenchStart"/>
      </actions>
    </cue>

    <cue name="BenchSpawn" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="$Hcp" exact="player.occupiedship"/>
        <do_if value="global.$HcpBenchKestrel? and global.$HcpBenchKestrel.exists">
          <debug_text text="'hcp-bench: removes the previous bench kestrel'" filter="scripts"/>
          <destroy_object object="global.$HcpBenchKestrel" explosion="false"/>
        </do_if>
        <do_if value="not $Hcp or $Hcp.macro != macro.ship_arg_l_hcp_01_a_macro">
          <debug_text text="'hcp-bench: kestrel skipped, the player is not flying the HCP'" filter="scripts"/>
        </do_if>
        <do_else>
          <set_value name="$Kestrel" exact="null"/>
          <find_dockingbay name="$Bay" object="$Hcp" checkoperational="true" multiple="false">
            <match_dock size="tag.dock_s" storage="false"/>
          </find_dockingbay>
          <do_if value="$Bay">
            <create_ship name="$Kestrel" macro="macro.ship_tel_s_scout_01_a_macro" dock="$Bay">
              <owner exact="faction.player"/>
              <loadout ref="hcp_derelict_kestrel"/>
              <people>
                <fillpercent exact="0"/>
              </people>
            </create_ship>
          </do_if>
          <set_value name="global.$HcpBenchKestrel" exact="$Kestrel"/>
          <do_if value="$Kestrel and $Kestrel.exists and $Kestrel.dock">
            <debug_text text="'hcp-bench: kestrel docked in ' + $Kestrel.dock.macro.id + ' of ' + $Kestrel.dock.container.macro.id + ' (S pad), owner ' + $Kestrel.trueowner" filter="scripts"/>
          </do_if>
          <do_else>
            <debug_text text="'hcp-bench: kestrel FAILED, bay found ' + ($Bay != null)" filter="error"/>
          </do_else>
          <set_value name="$Guns" exact="''"/>
          <do_for_each name="$W" in="$Hcp.weapons.all.list">
            <set_value name="$Guns" exact="$Guns + ' ' + $W.macro.id"/>
          </do_for_each>
          <debug_text text="'hcp-bench: equipment: engines ' + $Hcp.engines.all.count + '/' + $Hcp.engines.numslots + ', shields ' + $Hcp.shields.all.count + '/' + $Hcp.shields.numslots + ', weapons ' + $Hcp.weapons.all.count + '/' + $Hcp.weapons.numslots + ', turrets ' + $Hcp.turrets.all.count + ', missiles ' + $Hcp.ammostorage.missile.count" filter="scripts"/>
          <debug_text text="'hcp-bench: weapons:' + $Guns" filter="scripts"/>
        </do_else>
      </actions>
    </cue>
  </cues>
</mdscript>
