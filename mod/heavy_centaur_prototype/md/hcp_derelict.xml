<?xml version="1.0" encoding="utf-8"?>
<mdscript name="HcpDerelict" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <cue name="Init" namespace="this">
      <actions>
        <include_actions ref="EnsureGlobals"/>
      </actions>
      <cues>
        <cue name="Claimed" instantiate="true">
          <conditions>
            <event_object_changed_true_owner group="global.$HcpDerelicts" owner="faction.player"/>
          </conditions>
          <actions>
            <set_value name="$hcp" exact="event.object"/>
            <remove_from_group group="global.$HcpDerelicts" object="$hcp"/>
            <set_value name="$kestrel" exact="null"/>
            <do_if value="global.$HcpDerelictKestrels.{$hcp}?">
              <set_value name="$kestrel" exact="global.$HcpDerelictKestrels.{$hcp}"/>
              <remove_value name="global.$HcpDerelictKestrels.{$hcp}"/>
            </do_if>
            <set_value name="$kestrelstate" exact="'none'"/>
            <do_if value="$kestrel and $kestrel.exists">
              <do_if value="$kestrel.trueowner == faction.ownerless">
                <set_owner object="$kestrel" faction="faction.player"/>
                <set_value name="$kestrelstate" exact="'transferred to player'"/>
              </do_if>
              <do_else>
                <set_value name="$kestrelstate" exact="'already owned by player ' + $kestrel.isplayerowned"/>
              </do_else>
            </do_if>
            <debug_text text="'hcp-derelict: claimed by the player in ' + $hcp.sector.knownname + ', kestrel ' + $kestrelstate" filter="scripts"/>
          </actions>
        </cue>
        <cue name="Destroyed" instantiate="true">
          <conditions>
            <event_object_destroyed group="global.$HcpDerelicts"/>
          </conditions>
          <actions>
            <debug_text text="'hcp-derelict: destroyed while still ownerless'" filter="scripts"/>
          </actions>
        </cue>
      </cues>
    </cue>

    <cue name="PlaceOnNewGame">
      <conditions>
        <event_cue_signalled cue="md.Setup.GameStart"/>
      </conditions>
      <actions>
        <signal_cue cue="Place"/>
      </actions>
    </cue>

    <cue name="PlaceOnOldSave" onfail="cancel">
      <conditions>
        <check_value value="player.age" min="10s"/>
      </conditions>
      <actions>
        <signal_cue cue="Place"/>
      </actions>
    </cue>

    <cue name="Place" namespace="this">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <delay exact="3s"/>
      <actions>
        <include_actions ref="EnsureGlobals"/>
        <set_value name="$existing" exact="0"/>
        <find_ship name="$hcps" macro="macro.ship_arg_l_hcp_01_a_macro" space="player.galaxy" multiple="true"/>
        <do_for_each name="$s" in="$hcps">
          <do_if value="not $s.isplayerowned">
            <set_value name="$existing" operation="add"/>
          </do_if>
        </do_for_each>
        <do_if value="global.$HcpDerelictPlaced?">
          <debug_text text="'hcp-derelict: already placed in this game, nothing to do'" filter="scripts"/>
        </do_if>
        <do_elseif value="$existing gt 0">
          <set_value name="global.$HcpDerelictPlaced" exact="true"/>
          <debug_text text="'hcp-derelict: ' + $existing + ' non-player HCP already in the galaxy, not placing another'" filter="scripts"/>
        </do_elseif>
        <do_else>
          <find_sector name="$sector" macro="macro.cluster_06_sector001_macro" space="player.galaxy"/>
          <do_if value="$sector and $sector.exists">
            <run_actions ref="CreateDerelict" result="$result">
              <param name="Label" value="'placement'"/>
              <param name="Sector" value="$sector"/>
              <param name="Position" value="position.[-213470m, 11860m, -207130m]"/>
              <param name="Rotation" value="rotation.[37deg, -14deg, 22deg]"/>
            </run_actions>
            <do_if value="$result.$hcp">
              <set_value name="global.$HcpDerelictPlaced" exact="true"/>
              <set_value name="global.$HcpDerelict" exact="$result.$hcp"/>
              <debug_text text="'hcp-derelict: real placement in ' + $sector.knownname + ' (' + $sector.macro.id + ') at sector position ' + $result.$hcp.relativeposition.{$sector} + ', sector coresize ' + $sector.coresize" filter="scripts"/>
            </do_if>
          </do_if>
          <do_else>
            <debug_text text="'hcp-derelict: FAILED, sector cluster_06_sector001_macro (Black Hole Sun IV) not found in this galaxy'" filter="error"/>
          </do_else>
        </do_else>
      </actions>
    </cue>

    <library name="EnsureGlobals">
      <actions>
        <do_if value="not global.$HcpDerelicts?">
          <create_group groupname="global.$HcpDerelicts"/>
        </do_if>
        <do_if value="not global.$HcpDerelictKestrels?">
          <set_value name="global.$HcpDerelictKestrels" exact="table[]"/>
        </do_if>
      </actions>
    </library>

    <library name="CreateDerelict" purpose="run_actions">
      <params>
        <param name="Label"/>
        <param name="Sector"/>
        <param name="Position"/>
        <param name="Rotation"/>
      </params>
      <actions>
        <include_actions ref="EnsureGlobals"/>
        <debug_text text="'hcp-derelict: ' + $Label + ' creating the derelict in ' + $Sector.knownname + ' at requested sector position ' + $Position" filter="scripts"/>
        <create_ship name="$Hcp" macro="macro.ship_arg_l_hcp_01_a_macro" sector="$Sector">
          <owner exact="faction.ownerless"/>
          <loadout ref="hcp_derelict"/>
          <people>
            <fillpercent exact="0"/>
          </people>
          <position value="$Position"/>
          <rotation value="$Rotation"/>
        </create_ship>
        <do_if value="not $Hcp or not $Hcp.exists">
          <debug_text text="'hcp-derelict: ' + $Label + ' FAILED to create ship_arg_l_hcp_01_a_macro'" filter="error"/>
          <return value="table[$hcp = null, $kestrel = null]"/>
        </do_if>
        <set_object_hull object="$Hcp" exact="75"/>
        <add_ammo object="$Hcp" macro="macro.missile_gen_s_torpedo_01_mk1_macro" amount="5"/>
        <add_ammo object="$Hcp" macro="macro.missile_gen_s_dumbfire_01_mk1_macro" amount="6"/>
        <add_to_group groupname="global.$HcpDerelicts" object="$Hcp"/>

        <set_value name="$Kestrel" exact="null"/>
        <set_value name="$KestrelWhere" exact="'not created'"/>
        <find_dockingbay name="$Bay" object="$Hcp" checkoperational="true" multiple="false">
          <match_dock size="tag.dock_s" storage="true"/>
        </find_dockingbay>
        <do_if value="$Bay">
          <create_ship name="$Kestrel" macro="macro.ship_tel_s_scout_01_a_macro" dock="$Bay">
            <owner exact="faction.ownerless"/>
            <loadout ref="hcp_derelict_kestrel"/>
            <people>
              <fillpercent exact="0"/>
            </people>
          </create_ship>
        </do_if>
        <do_if value="$Kestrel and $Kestrel.exists and $Kestrel.dock">
          <set_value name="$KestrelWhere" exact="'docked in ' + $Kestrel.dock.macro.id + ' of ' + $Kestrel.dock.container.macro.id + ' (S storage)'"/>
        </do_if>
        <do_else>
          <do_if value="$Kestrel and $Kestrel.exists">
            <destroy_object object="$Kestrel" explosion="false"/>
          </do_if>
          <create_position name="$KestrelPos" object="$Hcp" x="350m" y="40m" z="-120m" space="$Sector"/>
          <create_ship name="$Kestrel" macro="macro.ship_tel_s_scout_01_a_macro" sector="$Sector">
            <owner exact="faction.ownerless"/>
            <loadout ref="hcp_derelict_kestrel"/>
            <people>
              <fillpercent exact="0"/>
            </people>
            <position value="$KestrelPos"/>
            <rotation value="$Rotation"/>
          </create_ship>
          <do_if value="$Kestrel and $Kestrel.exists">
            <set_value name="$KestrelWhere" exact="'FALLBACK beside the HCP at ' + $Kestrel.distanceto.{$Hcp} + ' (storage dock found ' + ($Bay != null) + ')'"/>
          </do_if>
        </do_else>
        <do_if value="$Kestrel and $Kestrel.exists">
          <set_value name="global.$HcpDerelictKestrels.{$Hcp}" exact="$Kestrel"/>
        </do_if>

        <set_value name="$Final" exact="$Hcp.relativeposition.{$Sector}"/>
        <debug_text text="'hcp-derelict: ' + $Label + ' created in ' + $Sector.knownname + ' at sector position ' + $Final + ' (' + $Final.distanceto.{$Position} + ' from the requested one), rotation ' + $Hcp.rotation + ', hull ' + $Hcp.hullpercentage + ' percent'" filter="scripts"/>
        <do_if value="$Kestrel and $Kestrel.exists">
          <debug_text text="'hcp-derelict: ' + $Label + ' kestrel ' + $KestrelWhere" filter="scripts"/>
        </do_if>
        <do_else>
          <debug_text text="'hcp-derelict: ' + $Label + ' kestrel FAILED, ' + $KestrelWhere" filter="error"/>
        </do_else>
        <return value="table[$hcp = $Hcp, $kestrel = $Kestrel]"/>
      </actions>
    </library>
  </cues>
</mdscript>
